"g474_driver\stm32g4xx_hal_flash_ramfunc.o"
"g474_driver\stm32g4xx_hal_gpio.o"
"g474_driver\stm32g4xx_hal_exti.o"
"g474_driver\stm32g4xx_hal_dma.o"
